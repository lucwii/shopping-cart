created:
    - database/factories/ProductFactory.php
    - database/factories/CartFactory.php
    - database/factories/CartItemFactory.php
    - database/factories/OrderFactory.php
    - database/factories/OrderItemFactory.php
    - database/migrations/2025_12_27_112119_create_products_table.php
    - database/migrations/2025_12_27_112120_create_carts_table.php
    - database/migrations/2025_12_27_112121_create_cart_items_table.php
    - database/migrations/2025_12_27_112122_create_orders_table.php
    - database/migrations/2025_12_27_112123_create_order_items_table.php
    - app/Models/Product.php
    - app/Models/Cart.php
    - app/Models/CartItem.php
    - app/Models/Order.php
    - app/Models/OrderItem.php
models:
    User: { name: string, email: string, email_verified_at: 'timestamp nullable default:NULL', password: string, two_factor_secret: 'text nullable default:NULL', two_factor_recovery_codes: 'text nullable default:NULL', two_factor_confirmed_at: 'timestamp nullable default:NULL', remember_token: 'string:100 nullable default:NULL' }
    Product: { name: string, price: 'decimal(8,2)', stock_quantity: integer, image: 'string nullable', timestamps: timestamps }
    Cart: { user_id: 'id foreign:users', timestamps: timestamps, relationships: { belongsTo: User, hasMany: CartItem } }
    CartItem: { cart_id: 'id foreign:carts', product_id: 'id foreign:products', quantity: 'integer default:1', timestamps: timestamps, relationships: { belongsTo: 'Cart, Product' } }
    Order: { user_id: 'id foreign:users', total_amount: 'decimal(10,2)', status: 'string default:pending', timestamps: timestamps, relationships: { belongsTo: User, hasMany: OrderItem } }
    OrderItem: { order_id: 'id foreign:orders', product_id: 'id foreign:products', quantity: integer, price: 'decimal(8,2)', timestamps: timestamps, relationships: { belongsTo: 'Order, Product' } }
